{
  "name": "sponsifer",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Tools for streamers who run OBS: put a sponsor on stream, log every second they were on air, and sign a report the sponsor checks with OpenSSH. Prices the deal too. Local-first, no account, no telemetry.",
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/dev-api.mjs",
    "build": "tsc --noEmit && vite build",
    "dev:site": "vite --config vite.site.config.ts",
    "build:site": "tsc --noEmit && vite build --config vite.site.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/check.mjs",
    "bundle": "npm run build && node scripts/bundle-web.mjs"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uqr": "^0.1.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "author": "S. Lavi (@idl3o)",
  "repository": {
    "type": "git",
    "url": "https://github.com/idl3o/sponsifer.git"
  },
  "keywords": [
    "creator-economy",
    "sponsorship",
    "rate-card",
    "media-kit",
    "pricing",
    "local-first",
    "creators",
    "influencer-marketing",
    "obs",
    "twitch",
    "streaming"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
